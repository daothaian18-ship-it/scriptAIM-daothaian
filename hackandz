local HighlightESPEnabled = false
local ESPConnections = {}

local function RemoveHighlight(plr)

    if plr.Character then

        local Old =
            plr.Character:FindFirstChild(
                "DTA_ESP"
            )

        if Old then
            Old:Destroy()
        end
    end
end

local function ApplyHighlight(plr)

    if plr == LocalPlayer then
        return
    end

    local function Setup(Character)

        if not Character then
            return
        end

        RemoveHighlight(plr)

        if HighlightESPEnabled then

            local Highlight =
                Instance.new("Highlight")

            Highlight.Name =
                "DTA_ESP"

            Highlight.FillColor =
                Color3.fromRGB(
                    0,
                    255,
                    255
                )

            Highlight.OutlineColor =
                Color3.fromRGB(
                    255,
                    255,
                    255
                )

            Highlight.FillTransparency = 0.5
            Highlight.OutlineTransparency = 0

            Highlight.DepthMode =
                Enum.HighlightDepthMode.AlwaysOnTop

            Highlight.Adornee =
                Character

            Highlight.Parent =
                Character
        end
    end

    if plr.Character then
        Setup(plr.Character)
    end

    if not ESPConnections[plr] then

        ESPConnections[plr] =
            plr.CharacterAdded:Connect(
                function(Character)

                    task.wait(0.5)

                    Setup(Character)

                end
            )
    end
end

local function UpdateAllHighlight()

    for _, plr in ipairs(
        Players:GetPlayers()
    ) do

        if plr ~= LocalPlayer then

            if HighlightESPEnabled then

                ApplyHighlight(plr)

            else

                RemoveHighlight(plr)

            end
        end
    end
end

