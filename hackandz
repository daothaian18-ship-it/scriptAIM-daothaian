local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui") 
local player = Players.LocalPlayer
local mouse = player:GetMouse()
local camera = workspace.CurrentCamera

local MY_IMAGE_ID = "97528657105942" 
local AVATAR_SIZE = 55 -- Kích thước ảnh thu nhỏ
local AVATAR_Y_POSITION = 0.10 -- Độ cao đẩy lên trên

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = true
fovCircle.Radius = 220
fovCircle.Color = Color3.fromRGB(0, 255, 255)
fovCircle.Thickness = 1
fovCircle.Filled = false

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AvatarScreenGui"
screenGui.ResetOnSpawn = false 

local success, err = pcall(function()
    screenGui.Parent = CoreGui
end)
if not success then
    screenGui.Parent = player:WaitForChild("PlayerGui")
end

local avatarImage = Instance.new("ImageLabel")
avatarImage.Name = "AvatarImage"
avatarImage.Size = UDim2.new(0, AVATAR_SIZE, 0, AVATAR_SIZE)
avatarImage.Image = "rbxthumb://type=Asset&id=" .. MY_IMAGE_ID .. "&w=150&h=150"
avatarImage.BackgroundTransparency = 1 
avatarImage.AnchorPoint = Vector2.new(0.5, 0.5) 
avatarImage.Visible = true
avatarImage.Parent = screenGui

local HITBOX_SIZE = 5 

local Lines = {}

local function removeAllESP(p)
    if Lines[p] then
        Lines[p].Visible = false 
        Lines[p]:Destroy()
        Lines[p] = nil
    end
    if p.Character then
        if p.Character:FindFirstChild("EnemyHighlight") then
            p.Character.EnemyHighlight:Destroy()
        end
        local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("head")
        if head then
            if head:FindFirstChild("HealthESP") then
                head.HealthESP:Destroy()
            end
            if head:IsA("BasePart") then
                head.Size = Vector3.new(2, 1, 1) 
                head.Transparency = 0
            end
        end
    end
end

Players.PlayerRemoving:Connect(removeAllESP)

local function isTeamMate(v)
    if not player.Team or not v.Team then return false end
    return player.Team == v.Team
end

local function isVisible(part, character)
    if not part then return false end
    local ignoreList = {player.Character, character, camera}
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = ignoreList
    
    local direction = part.Position - camera.CFrame.Position
    local raycastResult = workspace:Raycast(camera.CFrame.Position, direction, raycastParams)
    return raycastResult == nil
end

local function getTargetPart(character)
    if not character then return nil end
    return character:FindFirstChild("Head") or character:FindFirstChild("head")
end

local function applyVisualESP(v)
    if not v.Character then return end

    local head = getTargetPart(v.Character)
    if head and not head:FindFirstChild("HealthESP") then
        local bbGui = Instance.new("BillboardGui")
        bbGui.Name = "HealthESP"
        bbGui.Adornee = head
        bbGui.Size = UDim2.new(0, 35, 0, 5)
        bbGui.AlwaysOnTop = true
        bbGui.StudsOffset = Vector3.new(0, 1.8, 0)

        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BorderSizePixel = 0
        bg.Parent = bbGui

        local bar = Instance.new("Frame")
        bar.Name = "HealthBar"
        bar.Size = UDim2.new(1, 0, 1, 0)
        bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        bar.BorderSizePixel = 0
        bar.Parent = bg

        local text = Instance.new("TextLabel")
        text.Name = "HealthText"
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.TextColor3 = Color3.fromRGB(255, 255, 255)
        text.TextSize = 8
        text.Font = Enum.Font.SourceSansBold
        text.TextStrokeTransparency = 0
        text.Parent = bg

        bbGui.Parent = head
    end
end

local function getClosestPlayerToCursor()
    local closestPlayer = nil
    local shortestDistance = fovCircle.Radius
    local allPlayers = Players:GetPlayers()

    for i = 1, #allPlayers do
        local v = allPlayers[i]
        if v ~= player and not isTeamMate(v) and v.Character then
            local targetPart = getTargetPart(v.Character)
            if targetPart and isVisible(targetPart, v.Character) then
                local humanoid = v.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local pos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                        if distance < shortestDistance then
                            closestPlayer = v
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    fovCircle.Position = screenCenter

    avatarImage.Position = UDim2.new(0.5, 0, AVATAR_Y_POSITION, 0)
    avatarImage.Size = UDim2.new(0, AVATAR_SIZE, 0, AVATAR_SIZE)

    local currentTarget = getClosestPlayerToCursor()
    local allPlayers = Players:GetPlayers()

    for i = 1, #allPlayers do
        local v = allPlayers[i]
        if v ~= player then
            
            if isTeamMate(v) then
                removeAllESP(v)
                continue
            end

            local char = v.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if char and humanoid and humanoid.Health > 0 then
                applyVisualESP(v)
                local head = getTargetPart(char)
                
                if head then
                    
                    head.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
                    head.Transparency = 0.7
                    head.CanCollide = false

                    local healthESP = head:FindFirstChild("HealthESP")
                    local bg = healthESP and healthESP:FindFirstChild("Frame")
                    local bar = bg and bg:FindFirstChild("HealthBar")
                    local text = bg and bg:FindFirstChild("HealthText")
                    
                    if bar and text then
                        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        bar.Size = UDim2.new(healthPercent, 0, 1, 0)
                        text.Text = math.floor(humanoid.Health)
                        bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                    end

                    if not Lines[v] then
                        local newLine = Drawing.new("Line")
                        newLine.Color = Color3.fromRGB(255, 0, 0)
                        newLine.Thickness = 1.2
                        newLine.Transparency = 0.8
                        newLine.Visible = false
                        Lines[v] = newLine
                    end

                    local line = Lines[v]
                    local headPosOnScreen, onScreen = camera:WorldToViewportPoint(head.Position)

                    if onScreen then
                        line.From = screenCenter
                        line.To = Vector2.new(headPosOnScreen.X, headPosOnScreen.Y)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                end
            else
                removeAllESP(v)
            end
        end
    end

    local isLeftMouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    local isRightMouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

    if currentTarget and currentTarget.Character and (isLeftMouseDown or isRightMouseDown) then
        local targetPart = getTargetPart(currentTarget.Character)
        if targetPart then
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
        end
    end
end)
