local function GetClosestPlayer()

    local Closest = nil

    local ShortestDistance =
        FOVCircle.Radius

    for _, plr in ipairs(Players:GetPlayers()) do

        if plr ~= LocalPlayer
            and not IsTeamMate(plr)
            and plr.Character then

            local Head =
                GetTargetPart(plr.Character)

            local Humanoid =
                plr.Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Head
                and Humanoid
                and Humanoid.Health > 0
                and IsVisible(Head, plr.Character) then

                local Position, OnScreen =
                    Camera:WorldToViewportPoint(
                        Head.Position
                    )

                if OnScreen then

                    local Distance =
                        (
                            Vector2.new(
                                Mouse.X,
                                Mouse.Y
                            )
                            -
                            Vector2.new(
                                Position.X,
                                Position.Y
                            )
                        ).Magnitude

                    if Distance < ShortestDistance then

                        Closest = plr
                        ShortestDistance = Distance

                    end
                end
            end
        end
    end

    return Closest
end

RunService.RenderStepped:Connect(function()

    Camera = workspace.CurrentCamera

    local ScreenCenter =
        Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

    FOVCircle.Position =
        ScreenCenter

    local CurrentTarget =
        GetClosestPlayer()

    for _, plr in ipairs(Players:GetPlayers()) do

        if plr ~= LocalPlayer then

            if IsTeamMate(plr) then

                RemoveESP(plr)

                continue
            end

            local Character =
                plr.Character

            local Humanoid =
                Character
                and Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Character
                and Humanoid
                and Humanoid.Health > 0 then

                ApplyHealthESP(plr)

                local Head =
                    GetTargetPart(Character)

                if Head then

                    Head.Size =
                        Vector3.new(
                            HITBOX_SIZE,
                            HITBOX_SIZE,
                            HITBOX_SIZE
                        )

                    Head.Transparency = 0.7
                    Head.CanCollide = false


                    local HealthESP =
                        Head:FindFirstChild(
                            "HealthESP"
                        )

                    local Background =
                        HealthESP
                        and HealthESP:FindFirstChild(
                            "Frame"
                        )

                    local Bar =
                        Background
                        and Background:FindFirstChild(
                            "HealthBar"
                        )

                    local Text =
                        Background
                        and Background:FindFirstChild(
                            "HealthText"
                        )

                    if Bar and Text then

                        local MaxHealth =
                            math.max(
                                Humanoid.MaxHealth,
                                1
                            )

                        local Percent =
                            math.clamp(
                                Humanoid.Health
                                /
                                MaxHealth,
                                0,
                                1
                            )

                        Bar.Size =
                            UDim2.new(
                                Percent,
                                0,
                                1,
                                0
                            )

                        Text.Text =
                            tostring(
                                math.floor(
                                    Humanoid.Health
                                )
                            )

                        Bar.BackgroundColor3 =
                            Color3.fromRGB(
                                255,
                                0,
                                0
                            ):Lerp(
                                Color3.fromRGB(
                                    0,
                                    255,
                                    0
                                ),
                                Percent
                            )
                    end


                    if not Lines[plr] then

                        local Line =
                            Drawing.new("Line")

                        Line.Color =
                            Color3.fromRGB(
                                255,
                                0,
                                0
                            )

                        Line.Thickness = 1.2
                        Line.Transparency = 0.8
                        Line.Visible = false

                        Lines[plr] = Line
                    end

                    local Line =
                        Lines[plr]

                    local Position, OnScreen =
                        Camera:WorldToViewportPoint(
                            Head.Position
                        )

                    if OnScreen then

                        Line.From =
                            ScreenCenter

                        Line.To =
                            Vector2.new(
                                Position.X,
                                Position.Y
                            )

                        Line.Visible = true

                    else

                        Line.Visible = false

                    end
                end

            else

                RemoveESP(plr)

            end
        end
    end


    local Left =
        UserInputService:IsMouseButtonPressed(
            Enum.UserInputType.MouseButton1
        )

    local Right =
        UserInputService:IsMouseButtonPressed(
            Enum.UserInputType.MouseButton2
        )

    if CurrentTarget
        and CurrentTarget.Character
        and (Left or Right) then

        local TargetPart =
            GetTargetPart(
                CurrentTarget.Character
            )

        if TargetPart then

            Camera.CFrame =
                CFrame.new(
                    Camera.CFrame.Position,
                    TargetPart.Position
                )

        end
    end
end)

